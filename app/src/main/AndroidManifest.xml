<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Sumi is local-first. No INTERNET permission is declared.
      Usage Access (PACKAGE_USAGE_STATS) is a special permission granted in system
      Settings via AppOpsManager check; see platform/usage/UsageAccess. Do not add INTERNET.
    -->
    <!-- Notification permission is requested only when the user enables a reminder (Android 13+).
         Declared here, never requested at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required for Sumi to appear on the Usage Access screen (Settings.ACTION_USAGE_ACCESS_SETTINGS).
         Special access: granted in system Settings, never via runtime dialog.
         ProtectedPermissions ignore: lint misclassifies PACKAGE_USAGE_STATS (it is the canonical
         special-access permission granted via Settings, not a system-only permission). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Records reboot instants for usage-engine R5. No special permission needed. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Focus session foreground service (§16.5): user-chosen, start-and-end explicitly,
         ongoing ongoing notification; anyone killing it leaves an honest interrupted row. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- App discovery per AGENTS.md §2: visibility of launchable apps only, via the
         launcher intent filter (never QUERY_ALL_PACKAGES). This is what lets Sumi
         resolve display labels and launcher icons (platform/applications) for
         packages already seen in usage stats.
         The HOME entry makes the default launcher visible so it can be resolved and
         excluded from tracked usage (platform/usage/ExcludedPackagesResolver). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <!-- RemoveWorkManagerInitializer ignore: SumiApplication implements Configuration.Provider
         with HiltWorkerFactory, so WorkManager uses on-demand initialization and the default
         initializer is removed below via tools:node="remove" (official hilt-work setup). -->
    <application
        android:name=".SumiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sumi"
        android:usesCleartextTraffic="false"
        tools:targetApi="35"
        tools:ignore="RemoveWorkManagerInitializer">

        <!-- hilt-work uses on-demand WorkManager initialization (HiltWorkManagerFactory).
             Remove the default initializer so androidx.hilt work doesn't deadlock at startup.
             Instantiatable ignore: lint checks the removed provider's class which WorkManager
             initializes with a Context arg; the removal itself is the officially supported path. -->
        <provider
            android:name="androidx.work.WorkManagerInitializer"
            tools:node="remove"
            tools:ignore="Instantiatable" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Sumi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".platform.usage.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Foreground service for an active Focus session. SPECIAL_USE per Android 14:
             persistent user-chosen countdown; not data sync, not location, not media. -->
        <service
            android:name=".platform.focus.FocusSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="35">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_session_timer" />
        </service>
    </application>

</manifest>
